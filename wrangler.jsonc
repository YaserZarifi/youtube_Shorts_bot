{
  "name": "reels-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "b78b0821654e45b3aa97fd2d07d21e76"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *", "30 4 * * 5"]
  },
  "vars": {
    "MAX_UPLOADS_PER_DAY": "3",
    "MIN_HOURS_BETWEEN_UPLOADS": "6",
    "DISPLAY_TIMEZONE": "Asia/Kabul",
    "POSTING_WINDOW_START_HOUR": "13",
    "POSTING_WINDOW_END_HOUR": "1"
  }
}



